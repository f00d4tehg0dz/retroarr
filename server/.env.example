# RetroArr Server Configuration
# Copy this to .env and fill in your values.
#
# Real environment variables (Docker, systemd, your shell) always override
# this file. This file is for local/manual installs only — it is never
# copied into the Docker image.

# HTTP server port (HDHomeRun convention: 5004 or 8888)
PORT=8888

# RetroArr metadata API base URL — no /api suffix (routes are at root: /videos, /health, etc.)
REMOTE_API_URL=https://retroarr-api.f00d.me

# Friendly name shown in Plex/Jellyfin
DEVICE_NAME=RetroArr

# Stream output quality: 360p, 480p, 720p or 1080p
STREAM_QUALITY=720p

# Number of simultaneous tuner streams
TUNER_COUNT=4

# ── External binaries ───────────────────────────────────────────────
# Leave these unset to auto-detect: RetroArr looks in ./scripts, ./bin,
# /usr/local/bin and your PATH, and falls back to `python3 -m yt_dlp`.
# Only set them if you keep the binaries somewhere unusual. A path that does
# not exist on the current OS is ignored with a warning (so a Windows path
# here can never break a Linux install).
#FFMPEG_PATH=ffmpeg
#FFPROBE_PATH=ffprobe
#YTDLP_PATH=yt-dlp
# Windows example:
#YTDLP_PATH=C:\tools\yt-dlp.exe

# ── yt-dlp behaviour ────────────────────────────────────────────────
# Netscape-format cookies file. Fixes "Sign in to confirm you're not a bot"
# and age-restricted videos. Export with a browser extension such as
# "Get cookies.txt LOCALLY".
#YTDLP_COOKIES=./db/cookies.txt

# Extra arguments appended to every yt-dlp call (power users)
#YTDLP_EXTRA_ARGS=--extractor-args youtube:player_client=default

# JavaScript runtime for YouTube challenge solving: auto (default — uses the
# running Node if >= 22), deno, node, or none
#YTDLP_JS_RUNTIME=auto

# Max videos pulled per playlist/channel source during a plugin sync
#YTDLP_PLAYLIST_LIMIT=1000

# Kill a stuck yt-dlp call after this many ms
#YTDLP_TIMEOUT_MS=90000

# ── Discovery ───────────────────────────────────────────────────────
# Pin the HDHomeRun device ID (8 hex chars). Auto-generated and persisted
# in db.json when unset. Changing it makes Plex see a "new" tuner.
#DEVICE_ID=104A7F3C

# LAN IP to advertise to media servers (auto-detected when unset)
#ADVERTISE_IP=192.168.1.50

# Set to false to disable a discovery responder
#ENABLE_HDHR_DISCOVERY=true
#ENABLE_SSDP=true

# ── Storage ─────────────────────────────────────────────────────────
# Path to local database JSON file
DB_PATH=./db/db.json

# Where plugin configs installed from the dashboard are stored
#PLUGINS_DIR=../plugins

# Folder of local commercial clips (mp4/mkv/…) for ad breaks
#COMMERCIALS_DIR=./data/commercials

# How often to refresh from remote API (hours)
CACHE_REFRESH_HOURS=24

# Timezone for cron jobs
TZ=America/New_York
